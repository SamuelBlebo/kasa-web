rules_version = '2';

// Product and service photos, scoped to the tenant: organizations/{orgId}/items/...
service firebase.storage {
  match /b/{bucket}/o {
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function memberOf(orgId) {
      return request.auth != null && profile().orgId == orgId;
    }

    function canEditCatalog(orgId) {
      return memberOf(orgId) && profile().role in ['owner', 'manager'];
    }

    match /organizations/{orgId}/{allPaths=**} {
      allow read: if memberOf(orgId);
      allow write: if canEditCatalog(orgId)
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
