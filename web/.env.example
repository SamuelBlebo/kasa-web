# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (web).
# Vite only exposes variables prefixed with VITE_ to the browser. None of these are secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = use the local emulator suite (firebase emulators:start).
VITE_USE_FIREBASE_EMULATORS=false

# WhatsApp "Connect" button (Meta Embedded Signup). From your Meta App:
# App ID (App settings > Basic) and the Embedded Signup Configuration ID
# (Facebook Login for Business > Configurations). Leave blank and Settings >
# WhatsApp shows "not set up yet" instead of a broken button.
VITE_META_APP_ID=
VITE_META_CONFIGURATION_ID=

# Optional: Sentry error reporting.
VITE_SENTRY_DSN=
# Optional: Firebase Analytics page views.
VITE_FIREBASE_MEASUREMENT_ID=
