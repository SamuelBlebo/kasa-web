rules_version = '2';

// Kasa tenant isolation. Read the model in functions/src/domain/model.ts.
//
// The single source of tenancy is users/{uid}.{orgId, role}, which ONLY Cloud
// Functions write (createOrganization / acceptInvite). OrderFlow let the
// browser write that document, so any user could attach themselves to another
// business; that is closed here.
//
// Anything that moves money or stock, or that a customer's WhatsApp message
// produces (orders, payments, drafts, messages, stock movements), is written
// only by Cloud Functions. The browser edits catalog items, a few settings, and
// customer notes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function memberOf(orgId) {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.orgId == orgId;
    }

    // Roles mirror functions/src/domain/permissions.ts.
    function roleIn(orgId, roles) {
      return memberOf(orgId) && get(userDoc()).data.role in roles;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isPlatformAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function validItem(d) {
      return d.kind in ['product', 'service']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.priceMinor is int && d.priceMinor >= 0 && d.priceMinor <= 100000000
        && d.stock is int && d.stock >= 0
        && d.lowStockAt is int && d.lowStockAt >= 0
        && d.active is bool && d.trackStock is bool
        && d.aliases is list && d.aliases.size() <= 20
        && d.category is string && d.category.size() <= 40;
    }

    // ---- users: read your own; never written by a browser ----------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- organizations ------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if memberOf(orgId);
      allow create, delete: if false; // createOrganization / deleteMerchant only
      // Owner settings. Never plan, suspension, WhatsApp mirror, counters or ownership.
      allow update: if roleIn(orgId, ['owner'])
        && onlyChanges(['name', 'phone', 'area', 'category', 'businessType', 'deliveryFeeMinor', 'features', 'bot', 'momo', 'updatedAt'])
        && request.resource.data.deliveryFeeMinor is int && request.resource.data.deliveryFeeMinor >= 0
        && request.resource.data.businessType in ['food', 'retail', 'services', 'mixed'];

      match /members/{uid} {
        allow read: if memberOf(orgId);
        allow write: if false;
      }

      match /invites/{key} {
        allow read: if roleIn(orgId, ['owner']);
        allow write: if false;
      }

      // Catalog: products and services. Stock moves only through orders or adjustStock.
      match /items/{itemId} {
        allow read: if memberOf(orgId);
        allow create: if roleIn(orgId, ['owner', 'manager']) && validItem(request.resource.data);
        allow update: if roleIn(orgId, ['owner', 'manager']) && validItem(request.resource.data)
          && request.resource.data.stock == resource.data.stock
          && request.resource.data.kind == resource.data.kind;
        allow delete: if roleIn(orgId, ['owner', 'manager']);
      }

      match /stockMovements/{id} {
        allow read: if memberOf(orgId);
        allow write: if false;
      }

      match /customers/{waId} {
        allow read: if roleIn(orgId, ['owner', 'manager', 'cashier']);
        allow update: if (roleIn(orgId, ['owner', 'manager']) && onlyChanges(['note', 'tags', 'unreadCount', 'needsHuman', 'updatedAt']))
          || (roleIn(orgId, ['cashier']) && onlyChanges(['unreadCount', 'needsHuman', 'updatedAt']));
        allow create, delete: if false;

        match /messages/{messageId} {
          allow read: if roleIn(orgId, ['owner', 'manager', 'cashier']);
          allow write: if false;
        }
      }

      // Kitchen staff read orders for the kitchen screen; status changes go through updateOrderStatus.
      match /orders/{orderId} {
        allow read: if memberOf(orgId);
        allow update: if roleIn(orgId, ['owner', 'manager', 'cashier']) && onlyChanges(['note', 'updatedAt']);
        allow create, delete: if false;
      }

      match /draftOrders/{id} {
        allow read: if roleIn(orgId, ['owner', 'manager', 'cashier']);
        allow write: if false;
      }

      match /payments/{id} {
        allow read: if roleIn(orgId, ['owner', 'manager', 'cashier']);
        allow write: if false;
      }

      match /broadcasts/{id} {
        allow read: if roleIn(orgId, ['owner', 'manager']);
        allow write: if false;
      }

      match /qrCodes/{id} {
        allow read: if memberOf(orgId);
        allow write: if roleIn(orgId, ['owner', 'manager']);
      }

      match /auditLog/{id} {
        allow read: if roleIn(orgId, ['owner']);
        allow write: if false;
      }

      // paymentRefs, sessions, and anything else: functions only (catch-all below).
    }

    // ---- platform -------------------------------------------------------------
    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /featureFlags/{flagId} {
      allow read, write: if isPlatformAdmin();
    }

    match /platformLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // whatsappAccounts (Meta tokens), webhookEvents, invites, rateLimits and
    // everything not matched above: Cloud Functions only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
